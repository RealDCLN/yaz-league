# ============================================================
# YAZ LEAGUE - .env.example
# ------------------------------------------------------------
# Το site είναι 100% static (HTML/CSS/JS). Δεν υπάρχει build step
# και δεν διαβάζει αρχείο .env κατά το runtime.
# Τα δύο δημόσια keys του Supabase μπαίνουν στο js/config.js.
#
# Αυτό το αρχείο είναι αναφορά για το τι χρειάζεσαι.
# ΜΗΝ ανεβάσεις ποτέ το πραγματικό service_role key στο front-end.
# ============================================================

SUPABASE_URL=https://xxxxxxxxxxxxxxxx.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ΜΟΝΟ server-side. Μην το βάλεις ποτέ στο config.js.
# SUPABASE_SERVICE_ROLE_KEY=...

ADMIN_EMAIL=admin@example.com
# Ο διαχειριστής ορίζεται στη βάση (public.admins), όχι σε αυτό το αρχείο.
# Δες README → Supabase setup → Admin user.
