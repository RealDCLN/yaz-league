# ============================================================
# YAZ LEAGUE - environment reference
# ------------------------------------------------------------
# The site is 100% static (HTML/CSS/JS). It has no build step and
# does not read .env at runtime. The two public Supabase values go
# in js/config.js instead.
#
# This file is documentation only.
# ============================================================

# Supabase > Project Settings > API
SUPABASE_URL=https://xxxxxxxxxxxxxxxx.supabase.co
SUPABASE_ANON_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxx

# Server-side only. Never put this in js/config.js or the browser.
# SUPABASE_SERVICE_ROLE_KEY=...

# The admin is defined in the database allowlist (public.admins),
# not in this file. See README > Supabase setup.
